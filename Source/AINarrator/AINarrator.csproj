<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AINarrator</AssemblyName>
    <RootNamespace>Stellaris.AI</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamA\steamapps\common\RimWorld</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>$(GameDir)\System.Text.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(GameDir)\System.Net.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- RimLua：P2 的 Lua 事件运行时；MoonSharp 是 RimLua 依赖的解释器，需要 Table 类型 -->
    <Reference Include="RimLua">
      <HintPath>$(GameDir)\Mods\AIStory\1.7\Assemblies\RimLua.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>$(GameDir)\Mods\AIStory\1.7\Assemblies\MoonSharp.Interpreter.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
